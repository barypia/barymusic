# Local development configuration. Copy this file to .env and adjust as needed.
# Docker and the Windows portable launcher set HOST and PORT independently.
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000

# Comma-separated usernames. Leave empty when no users are preconfigured.
ADMINS=
CAN_ADD_SONGS=

ALLOW_ALL_USERS_TO_ADD_SONGS=true
ALLOW_REGISTRATION=true
